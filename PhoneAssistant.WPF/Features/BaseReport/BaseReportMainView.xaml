<UserControl x:Class="PhoneAssistant.WPF.Features.BaseReport.BaseReportMainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:shared="clr-namespace:PhoneAssistant.WPF.Shared"
             xmlns:viewmodel="clr-namespace:PhoneAssistant.WPF.Features.BaseReport"
             d:Background="Aqua"
             d:DataContext="{d:DesignInstance Type=viewmodel:BaseReportMainView,
                                              IsDesignTimeCreatable=False}"
             d:DesignHeight="450"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <shared:HeaderMainView HeaderIcon="AlphaECircleOutline" HeaderText="Base Report" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="2"
                       Margin="0,0,10,0"
                       VerticalAlignment="Bottom"
                       d:Text="Latest Import"
                       Foreground="#F5FFFFFF"
                       Style="{StaticResource MaterialDesignCaptionTextBlock}"
                       Text="{Binding LatestImport}"
                       TextAlignment="Right" />
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <TextBox x:Name="SearchPhoneNumber"
                     Width="160"
                     Margin="10,5,0,5"
                     HorizontalAlignment="Left"
                     materialDesign:HintAssist.Hint="Phone Number"
                     materialDesign:TextFieldAssist.CharacterCounterVisibility="Hidden"
                     materialDesign:TextFieldAssist.HasClearButton="True"
                     MaxLength="12"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Text="{Binding SearchPhoneNumber, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding PhoneNumberSearchCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <TextBox x:Name="SearchSimNumber"
                     Width="160"
                     Margin="10,5,0,5"
                     HorizontalAlignment="Left"
                     materialDesign:HintAssist.Hint="SIM Number"
                     materialDesign:TextFieldAssist.CharacterCounterVisibility="Hidden"
                     materialDesign:TextFieldAssist.HasClearButton="True"
                     MaxLength="19"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Text="{Binding SearchSimNumber, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SimNumberSearchCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <TextBox x:Name="SearchUserName"
                     Width="160"
                     Margin="10,5,0,5"
                     HorizontalAlignment="Left"
                     materialDesign:HintAssist.Hint="User Name"
                     materialDesign:TextFieldAssist.HasClearButton="True"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Text="{Binding SearchUserName, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding UserNameSearchCommand}" />
                </TextBox.InputBindings>
            </TextBox>
        </StackPanel>

        <ProgressBar Grid.Row="2"
                     Margin="0,10"
                     IsIndeterminate="True"
                     Visibility="{Binding ProgressVisibility}" />

        <DataGrid x:Name="BaseReportDataGrid"
                  Grid.Row="3"
                  MaxHeight="930"
                  Margin="10,5,0,0"
                  materialDesign:DataGridAssist.CellPadding="4 5 2 3"
                  materialDesign:DataGridAssist.ColumnHeaderPadding="4 5 2 7"
                  AlternatingRowBackground="{DynamicResource MaterialDesignChipBackground}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  ItemsSource="{Binding BaseReportSims}">
            <DataGrid.Columns>
                <DataGridTextColumn Width="120"
                                    Binding="{Binding PhoneNumber}"
                                    Header="Phone Number"
                                    IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding BillingPeriod}"
                                    Header="Billing Period"
                                    IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding SIMNumber}"
                                    Header="SIM Number"
                                    IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridCheckBoxColumn Binding="{Binding Esim, UpdateSourceTrigger=PropertyChanged, TargetNullValue=False}"
                                        Header="eSIM"
                                        IsReadOnly="True"
                                        IsThreeState="False" />
                <DataGridTextColumn Binding="{Binding UserName}"
                                    Header="User Name"
                                    IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn Header="Broadband Data">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Width="205" Height="20">
                                <Rectangle Width="{Binding BarWidth}"
                                           Height="20"
                                           HorizontalAlignment="Left"
                                           Fill="LightGreen"
                                           RadiusX="3"
                                           RadiusY="3"
                                           Stroke="Green"
                                           StrokeThickness="1" />
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Text="{Binding BroadbandDataText}" />
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Binding="{Binding TextMessages}"
                                    Header="Text Messages"
                                    IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding VoiceCalls}"
                                    Header="Voice Calls"
                                    IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    d:Visibility="Visible"
                    Orientation="Horizontal"
                    Visibility="{Binding NoResultsFound, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                       Text="No Results Found" />
        </StackPanel>

    </Grid>
</UserControl>
