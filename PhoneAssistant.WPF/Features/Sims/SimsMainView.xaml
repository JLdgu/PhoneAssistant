<UserControl x:Class="PhoneAssistant.WPF.Features.Sims.SimsMainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PhoneAssistant.WPF.Features.Sims"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:shared="clr-namespace:PhoneAssistant.WPF.Shared"
             xmlns:viewmodel="clr-namespace:PhoneAssistant.WPF.Features.Sims"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             d:Background="AntiqueWhite"
             d:DataContext="{d:DesignInstance Type=viewmodel:SimsMainViewModel,
                                              IsDesignTimeCreatable=False}"
             d:DesignHeight="250"
             d:DesignWidth="1500"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <shared:HeaderMainView Margin="0,0,5,0"
                               HeaderIcon="SimOutline"
                               HeaderText="SIMs" />
        <GroupBox Grid.Row="1"
                  Margin="2,10,5,0"
                  VerticalAlignment="Top"
                  materialDesign:ColorZoneAssist.Mode="SecondaryMid"
                  Header="New SIM orders"
                  Style="{StaticResource MaterialDesignGroupBox}">
            <StackPanel Margin="0,0,0,25" Orientation="Horizontal">
                <TextBox MinWidth="85"
                         Margin="0,0,0,0"
                         materialDesign:HintAssist.Hint="Ticket #"
                         materialDesign:TextFieldAssist.CharacterCounterVisibility="Hidden"
                         MaxLength="7"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Text="{Binding Ticket}" />

                <TextBox MinWidth="150"
                         Margin="10,0,0,0"
                         materialDesign:HintAssist.Hint="New User"
                         materialDesign:TextFieldAssist.CharacterCounterVisibility="Hidden"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Text="{Binding NewUser}" />

                <TextBox MinWidth="125  "
                         Margin="10,0,0,0"
                         materialDesign:HintAssist.Hint="Phone Number"
                         materialDesign:TextFieldAssist.CharacterCounterVisibility="Hidden"
                         MaxLength="11"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Text="{Binding PhoneNumber}" />

                <TextBox MinWidth="160"
                         Margin="10,0,0,0"
                         materialDesign:HintAssist.Hint="SIM Number"
                         materialDesign:TextFieldAssist.CharacterCounterVisibility="Hidden"
                         MaxLength="19"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Text="{Binding SimNumber}" />

                <Button Margin="20,0,0,0"
                        Padding="0"
                        Command="{Binding PrintEnvelopeCommand}"
                        Content="{materialDesign:PackIcon Kind=EmailOutline,
                                                          Size=35}"
                        Style="{StaticResource MaterialDesignFlatLightButton}"
                        ToolTip="Print Envelope" />

            </StackPanel>
        </GroupBox>

        <wv2:WebView2 Name="WebView2"
                      Grid.Row="2"
                      Width="800"
                      Height="400"
                      HorizontalAlignment="Left"
                      shared:WebBrowserHelper.NavigateTo="{Binding EmailHtml}"
                      Visibility="Visible"
                      ZoomFactor="0.8" />
    </Grid>
</UserControl>
