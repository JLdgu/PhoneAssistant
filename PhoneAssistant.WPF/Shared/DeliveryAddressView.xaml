<UserControl x:Class="PhoneAssistant.WPF.Shared.DeliveryAddressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PhoneAssistant.WPF.Shared"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Name="Root"
             d:DesignHeight="200"
             d:DesignWidth="400"
             mc:Ignorable="d">
    <StackPanel Orientation="Vertical">
        <ComboBox Width="330"
                  Margin="10,0,0,5"
                  Padding="10,10"
                  HorizontalAlignment="Left"
                  DisplayMemberPath="Name"
                  ItemsSource="{Binding Locations, ElementName=Root}"
                  SelectedItem="{Binding SelectedLocation, ElementName=Root, Mode=TwoWay}"
                  Style="{StaticResource MaterialDesignOutlinedComboBox}" />
        <TextBox Width="330"
                 Height="165"
                 Margin="10,0,0,10"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 materialDesign:HintAssist.Hint="Delivery Address"
                 AcceptsReturn="True"
                 BorderThickness="1"
                 FontSize="16"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 Text="{Binding DeliveryAddress, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" />
    </StackPanel>
</UserControl>